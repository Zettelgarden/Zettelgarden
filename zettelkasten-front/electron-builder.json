{
  "appId": "com.zettelgarden.desktop",
  "productName": "Zettelgarden",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "electron/**/*",
    "!node_modules/@esbuild/**",
    "!node_modules/@rollup/**",
    "!node_modules/vite/**"
  ],
  "mac": {
    "category": "public.app-category.productivity",
    "icon": "public/logo512.png",
    "target": [
      {
        "target": "dmg",
        "arch": ["universal"]
      },
      {
        "target": "zip",
        "arch": ["universal"]
      }
    ],
    "hardenedRuntime": true,
    "gatekeeperAssess": false
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Office"
  },
  "win": {
    "target": ["nsis"]
  }
}
