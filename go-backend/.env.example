# Zettelgarden Go backend — environment configuration reference
#
# NOTE: the docker-compose stack does NOT read this file directly. It reads a
# root `.env` — copy the committed root example (`cp .env.example .env`; the
# nginx docker-zettel-run.yml variant uses `zettel.env` with the same
# content). This file is the backend's own reference; keep it in sync with
# the root .env.example.

# Database Configuration
# SQLite is the only supported database (file-based, WAL mode, no external
# database server). Postgres was retired after the cutover (epic
# Zettelgarden-c7j, Phase 7b); DB_DRIVER is no longer read by the app.
SQLITE_PATH=./data/zettelgarden.db

# JWT Authentication
SECRET_KEY=your_secret_key_here_generate_with_openssl_rand_hex_32

# OIDC / SSO (opt-in) — e.g. Pocket ID
# All four provider values are required only when OIDC_ENABLED=true. When
# disabled, the OIDC routes return 404 and the frontend hides the SSO button.
# See docs/plans/2026-08-03-oidc-authentication-design.md.
# OIDC_ENABLED=true
# OIDC_ISSUER=https://pocket-id.example.com
# OIDC_CLIENT_ID=your_client_id
# OIDC_CLIENT_SECRET=your_client_secret
# OIDC_REDIRECT_URI=https://app.example.com/api/auth/oidc/callback
# Optional: label stored in users.oidc_provider for stable (provider, sub)
# lookups. Defaults to the OIDC_ISSUER host (e.g. pocket-id.example.com).
# OIDC_PROVIDER_LABEL=pocket-id

# GitHub OAuth login (enabled by default)
# Set GITHUB_AUTH_ENABLED=false to disable GitHub login (e.g. when a generic
# OIDC provider replaces it): the routes return 404 and the frontend hides the
# button (set VITE_GITHUB_AUTH_ENABLED=false at frontend build time too).
# The three client values are required only while GitHub login is enabled.
GITHUB_AUTH_ENABLED=true
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=https://app.example.com/api/auth/github/callback

# Calendar Encryption
CALENDAR_ENCRYPTION_KEY=generate_with_openssl_rand_base64_32
# Purpose: Encryption key for calendar passwords (AES-256-GCM)
# Requirements: 32+ character random string
# Generation: openssl rand -base64 32
# When required: For authenticated calendar feeds

# LLM Integration (Z.AI - OpenAI-compatible)
# Get an API key at https://z.ai
ZETTEL_LLM_KEY=your_zai_api_key_here
# Coding Plan (subscription) endpoint:
ZETTEL_LLM_ENDPOINT=https://api.z.ai/api/coding/paas/v4
# Pay-as-you-go balance endpoint (needs account top-up):
#   ZETTEL_LLM_ENDPOINT=https://api.z.ai/api/paas/v4
ZETTEL_LLM_DEFAULT_MODEL=glm-5.1
ZETTEL_LLM_SUMMARIZE_MODEL=glm-5.1
# Optional: enable the chunking/embeddings feature (default false).
# ZETTEL_RUN_CHUNKING_EMBEDDING=false

# Local File Storage
# Uploads persist on the server's local disk under this directory, which is
# created at startup (mode 0750) if missing. The default ./data/files sits next
# to the SQLite DB (SQLITE_PATH=./data/zettelgarden.db). In Docker, set this to
# /usr/src/app/data/files so it lands on the mounted data volume.
# See docs/plans/2026-07-29-s3-to-local-file-storage-design.md.
STORAGE_DIR=./data/files

# Stripe Payment Integration
# Billing is enabled by default (existing installs keep working unchanged).
# Set STRIPE_ENABLED=false to run an instance without payment processing:
# the STRIPE_* values below become optional, billing routes return 404, and
# the frontend hides subscription UI / unlocks pro features for everyone.
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTH_PRICE=
STRIPE_YEAR_PRICE=
STRIPE_BILLING_URL=

# Mail Service
# The Go backend reads exactly two mail vars (used to relay email). SMTP
# settings for the mail-service container use the separate ZETTEL_MAIL_* vars
# (see the root .env.example); the backend itself reads only the two vars
# above. These are optional for a bare install — leaving them unset only
# records a non-fatal validation warning, and the admin "verify your email"
# banner stays up until an email is sent.
MAIL_HOST=localhost
MAIL_PASSWORD=your_smtp_password

# Search (Typesense)
# The config loader treats the TYPESENSE_* trio as required (until search is
# made optional). These placeholders boot fine: Typesense init fails and
# search falls back to SQL full-text. To enable full-text/vector search, run
# the `typesense` compose service (see docker-compose.yml) with this same
# password and set the host to http://typesense:8108.
TYPESENSE_HOST=http://localhost:8108
TYPESENSE_PASSWORD=your_typesense_api_key
TYPESENSE_COLLECTION=zettelgarden

# Server Configuration
# Development mode (default false).
ZETTEL_DEV=false
# Port the API listens on (default 8080).
ZETTEL_PORT=8080
# Base URL of the app as seen from the browser — used as the CORS allowed
# origin and as the base for OAuth/OIDC redirects. Required (must contain ://).
ZETTEL_URL=http://localhost:3001
# Admin email for notifications; must contain '@'. Required.
ZETTEL_ADMIN_EMAIL=admin@example.com
# Optional log file path; empty = console logging (Docker-friendly).
# ZETTEL_BACKEND_LOG_LOCATION=

# Monitoring (optional)
# Heartbeat push URL for Uptime Kuma; the job scheduler pings it every minute
# when set.
# UPTIME_KUMA_PUSH_URL=https://uptime.example.com/api/push/abc123
