# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=zettelgarden
DB_PASS=your_password_here
DB_NAME=zettelgarden

# JWT Authentication
SECRET_KEY=your_secret_key_here_generate_with_openssl_rand_hex_32

# Calendar Encryption
CALENDAR_ENCRYPTION_KEY=generate_with_openssl_rand_base64_32
# Purpose: Encryption key for calendar passwords (AES-256-GCM)
# Requirements: 32+ character random string
# Generation: openssl rand -base64 32
# When required: For authenticated calendar feeds

# LLM Integration
ZETTEL_LLM_KEY=your_llm_api_key_here
ZETTEL_LLM_ENDPOINT=https://api.openai.com/v1

# S3/File Storage
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=

# Stripe Payment Integration
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Mail Service
MAIL_HOST=localhost
MAIL_PORT=5000
MAIL_FROM=noreply@zettelgarden.com

# Telegram Bot Configuration (optional)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_ALLOWED_USER_ID=123456789
TELEGRAM_ENABLED=false

# Server Configuration
PORT=8080
ENVIRONMENT=development
