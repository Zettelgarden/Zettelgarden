# =============================================================================
# Zettelgarden — environment configuration example
# =============================================================================
# Copy this file to `.env` at the repo root, then boot the stack with:
#
#     cp .env.example .env
#     docker compose up --build
#
# docker-compose.yml loads `.env` via `env_file: .env` for go-backend, and
# passes the VITE_* values into the frontend image build as ARGs. The
# nginx/TLS variant (docker-zettel-run.yml) reads `zettel.env` instead — same
# content, different filename:
#
#     cp .env.example zettel.env
#
# Every variable the stack reads is listed below, grouped by component:
#   * Go backend — everything except the VITE_* block
#   * Frontend   — the VITE_* block (BUILD-time, inlined into the JS bundle)
#
# Required vars are uncommented with placeholder values. Optional / opt-in
# vars are commented out so a plain copy boots with sensible self-host
# defaults (no Stripe, no GitHub OAuth, no OIDC, no mail, no Typesense).
# =============================================================================

# ---------------------------------------------------------------------------
# Core server
# ---------------------------------------------------------------------------

# Development mode (default false). Enables dev logging / relaxed behavior.
ZETTEL_DEV=false

# Port the Go API listens on inside the container (default 8080). The compose
# file maps host 8080 -> container 8080, so the API is reachable at
# http://localhost:8080.
ZETTEL_PORT=8080

# Base URL of the app as seen from the BROWSER (scheme://host[:port], no
# trailing slash or /api suffix). Used as the CORS allowed origin and as the
# base for OAuth/OIDC redirects (e.g. ${ZETTEL_URL}/api/auth/oidc/callback).
# With the plain docker-compose setup the frontend is served on host port
# 3001, so:
ZETTEL_URL=http://localhost:3001
# Behind a reverse proxy (or the nginx docker-zettel-run.yml variant that
# routes /api to the backend), use the public origin instead, e.g.
# ZETTEL_URL=https://app.example.com

# Admin email — required, must contain '@'. Used for notifications and the
# admin "verify your email" banner. Seeds admin_email in ./data/config.yaml
# on first boot; afterwards it is managed via the /admin settings UI.
ZETTEL_ADMIN_EMAIL=admin@example.com

# JWT signing secret — required. Generate one with:
#   openssl rand -hex 32
SECRET_KEY=change_me_openssl_rand_hex_32

# Optional log file path. Leave empty for console logging, which Docker
# captures for `docker compose logs`.
ZETTEL_BACKEND_LOG_LOCATION=

# ---------------------------------------------------------------------------
# Database (SQLite)
# ---------------------------------------------------------------------------
# SQLite is the only supported database (file-based, WAL mode, no external
# database server). The default ./data/zettelgarden.db resolves inside the
# container to /usr/src/app/data/zettelgarden.db, which docker-compose mounts
# on the host at ./go-backend/data. Back it up with `VACUUM INTO`, not a raw
# cp (see docs/runbooks/sqlite-backup.md).
SQLITE_PATH=./data/zettelgarden.db

# ---------------------------------------------------------------------------
# Local file storage
# ---------------------------------------------------------------------------
# Uploads persist on local disk under this directory (created at startup,
# mode 0750). The container default is /usr/src/app/data/files — the same
# data volume as the SQLite DB, so one backup covers both.
STORAGE_DIR=./data/files

# ---------------------------------------------------------------------------
# LLM (Z.AI / any OpenAI-compatible API)
# ---------------------------------------------------------------------------
# Powers summaries, chat and the chunking/embeddings pipeline. Get a key at
# https://z.ai. The Coding Plan (subscription) endpoint is shown; the
# pay-as-you-go balance endpoint is https://api.z.ai/api/paas/v4.
ZETTEL_LLM_KEY=your_zai_api_key_here
ZETTEL_LLM_ENDPOINT=https://api.z.ai/api/coding/paas/v4
ZETTEL_LLM_DEFAULT_MODEL=glm-5.1
ZETTEL_LLM_SUMMARIZE_MODEL=glm-5.1

# Optional: enable the chunking/embeddings feature (default false).
# ZETTEL_RUN_CHUNKING_EMBEDDING=false

# ---------------------------------------------------------------------------
# Mail — direct SMTP from the Go backend (OPTIONAL — off by default; 6er.6)
# ---------------------------------------------------------------------------
# Transactional email (validation, password reset, reminders) is sent directly
# from the Go backend over SMTP — there is no separate mail service. Without
# SMTP the instance boots mail-disabled: config.yaml seeds mail_enabled=false,
# the mail client is a no-op, and new accounts are auto-validated (no
# email-confirmation banner).
#
# To enable, uncomment and set real SMTP values:
#   SMTP_HOST        — your SMTP server hostname (also auto-enables mail)
#   SMTP_PORT        — SMTP port (default 587)
#   SMTP_USERNAME    — SMTP username (optional for local relays without auth)
#   SMTP_PASSWORD    — SMTP password (optional for local relays without auth)
#   SMTP_FROM        — From/sender address (required when mail is enabled)
#   SMTP_STARTTLS    — use STARTTLS (default true; set false for plaintext
#                      local relays). Port 465 uses implicit TLS.
#   MAIL_ENABLED     — optional override: MAIL_ENABLED=false forces mail off
#                      even when SMTP_HOST is set. When unset, mail is enabled
#                      iff SMTP_HOST is non-empty. Seeds mail_enabled in
#                      config.yaml on first boot; afterwards the /admin
#                      settings UI toggle governs (applies immediately).
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USERNAME=noreply@example.com
#SMTP_PASSWORD=smtp_password
#SMTP_FROM=noreply@example.com
#SMTP_STARTTLS=true

# ---------------------------------------------------------------------------
# Stripe billing (optional — disabled by default for self-hosted installs)
# ---------------------------------------------------------------------------
# The code default is STRIPE_ENABLED=true, but self-hosted instances should
# set false: the STRIPE_* values become optional, billing routes return 404,
# and pro features unlock for everyone. Set true only if you actually run
# payment processing.
STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_MONTH_PRICE=price_monthly_id
# STRIPE_YEAR_PRICE=price_yearly_id
# STRIPE_BILLING_URL=https://billing.stripe.com/p/login/...

# ---------------------------------------------------------------------------
# GitHub OAuth login (optional — disabled by default for self-hosted installs)
# ---------------------------------------------------------------------------
# The code default is GITHUB_AUTH_ENABLED=true, but for self-hosting we
# recommend false unless you register a GitHub OAuth app. The three client
# values are required only while enabled. Keep in sync with the frontend
# VITE_GITHUB_AUTH_ENABLED build arg below.
GITHUB_AUTH_ENABLED=false
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret
# GITHUB_REDIRECT_URI=https://app.example.com/api/auth/github/callback

# ---------------------------------------------------------------------------
# OIDC / SSO (optional — opt-in)
# ---------------------------------------------------------------------------
# Generic OpenID Connect provider (e.g. Pocket ID). The four provider values
# are required only when OIDC_ENABLED=true; when disabled the OIDC routes
# return 404 and the frontend hides the SSO button (VITE_OIDC_ENABLED must
# also be "true" at build time to show it).
# OIDC_ENABLED=true
# OIDC_ISSUER=https://pocket-id.example.com
# OIDC_CLIENT_ID=your_client_id
# OIDC_CLIENT_SECRET=your_client_secret
# OIDC_REDIRECT_URI=https://app.example.com/api/auth/oidc/callback
# OIDC_PROVIDER_LABEL=pocket-id

# ---------------------------------------------------------------------------
# Admin-managed settings (seeded into ./data/config.yaml on first boot)
# ---------------------------------------------------------------------------
# These are NON-SECRET admin settings managed via the /admin settings UI.
# The env var only SEEDS config.yaml on first boot; afterwards the file is the
# source of truth (edits apply immediately, no restart). See the admin
# Settings page for current values.

# Allow new user registration (default true). When false, public signup is
# rejected and the register link is hidden. Also seedable as SIGNUPS_ENABLED.
# OIDC_AUTO_PROVISION=true   # auto-create accounts on OIDC login (default true)
# JOB_RETENTION_DAYS=30      # days of completed/failed LLM job history to keep
# RSS_ARTICLE_RETENTION_DAYS=30  # days of unstarred, unconverted RSS articles
# ZETTEL_SUPPORT_EMAIL=       # support address shown to users in settings

# ---------------------------------------------------------------------------
# Typesense search (required by config; degrades to SQL full-text when down)
# ---------------------------------------------------------------------------
# NOTE: until search config is made optional, the Go config loader treats the
# TYPESENSE_* trio as REQUIRED — with ZETTEL_DEV=false a missing value fails
# startup. These placeholders let a fresh install boot; Typesense init then
# fails (connection refused) and main.go logs a warning, so search runs on the
# slower SQL full-text path. To enable real full-text/vector search, uncomment
# the `typesense` service in docker-compose.yml (give it this same
# TYPESENSE_PASSWORD) and set the host to http://typesense:8108.
TYPESENSE_HOST=http://localhost:8108
TYPESENSE_PASSWORD=change_me_typesense_api_key
TYPESENSE_COLLECTION=zettelgarden

# ---------------------------------------------------------------------------
# Related cards scoring (optional; defaults shown)
# ---------------------------------------------------------------------------
# Weights for the GET /api/cards/{id}/related scoring. Entity/tag weights are
# points per shared match; the semantic weight multiplies the 0-1 similarity
# score. RELATED_MAX_RESULTS caps how many related cards are returned.
# RELATED_ENTITY_WEIGHT=3
# RELATED_TAG_WEIGHT=1
# RELATED_SEMANTIC_WEIGHT=10
# RELATED_MAX_RESULTS=10

# ---------------------------------------------------------------------------
# Calendar encryption
# ---------------------------------------------------------------------------
# AES-256-GCM key for calendar feed passwords (32+ chars). Generate with:
#   openssl rand -base64 32
CALENDAR_ENCRYPTION_KEY=change_me_openssl_rand_base64_32

# ---------------------------------------------------------------------------
# Monitoring (optional)
# ---------------------------------------------------------------------------
# Heartbeat push URL for Uptime Kuma; the backend job scheduler pings it
# every minute when set.
# UPTIME_KUMA_PUSH_URL=https://uptime.example.com/api/push/abc123

# ---------------------------------------------------------------------------
# Frontend build args (VITE_*) — BUILD-TIME only
# ---------------------------------------------------------------------------
# Vite inlines these into the JS bundle at build time (they are declared as
# ARGs in zettelkasten-front/Dockerfile), so changing them requires
# `docker compose build` — a plain `docker compose up` is not enough. (The
# runtime `environment:` block on the frontend service cannot reach
# already-built static assets.)

# Base URL of the API as called from the browser (note the /api suffix).
VITE_URL=http://localhost:8080/api

# Appended to the document title (e.g. "Zettelgarden-prod"); use "dev" or
# "prod".
VITE_ENV=prod

# Show the SSO (OIDC) button. Dockerfile default is false (opt-in); set
# "true" only when OIDC_ENABLED=true above.
VITE_OIDC_ENABLED=false

# Overrides the OIDC button label (default "Continue with SSO").
# VITE_OIDC_LABEL=

# Show the GitHub login button. Dockerfile default is true; set "false" for
# self-hosted installs and keep in sync with GITHUB_AUTH_ENABLED above.
VITE_GITHUB_AUTH_ENABLED=false
