# .gitignore

# Node modules (React frontend)
/frontend/node_modules/

# Build directory (React frontend)
/frontend/build/

# Environment files
.env*

# Python virtual environment (Flask backend)
/backend/.venv/

# Python cache files (Flask backend)
__pycache__/
/backend/__pycache__/
*.pyc
*.pyo
*.pyd
/backend/*.pyc
/backend/*.pyo
/backend/*.pyd

# Database file (if using SQLite for example)
/backend/*.db
/go-backend/go-backend

# Log files
*.log

# OS generated files
.DS_Store
Thumbs.db

ios-app/Zettelgarden.xcodeproj/project.xcworkspace/xcuserdata/nick.xcuserdatad/UserInterfaceState.xcuserstate

# TypeScript incremental build information
tsconfig.tsbuildinfo
main

# Browser extension build artifacts
browser-extension/firefox/api/
browser-extension/firefox/content/
browser-extension/firefox/ui/
browser-extension/firefox/background.js
browser-extension/chrome/api/
browser-extension/chrome/content/
browser-extension/chrome/ui/
browser-extension/chrome/background.js