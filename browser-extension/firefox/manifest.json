{
  "manifest_version": 2,
  "name": "Zettelgarden",
  "version": "0.0.1",
  "description": "Create Zettelgarden cards directly from your browser",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_popup": "ui/popup.html",
    "default_title": "Zettelgarden",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{811cf34f-34c1-47bc-85c9-b0f611a5cf71}"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/Readability.js",
        "content/extractor.js"
      ],
      "run_at": "document_idle"
    }
  ]
}