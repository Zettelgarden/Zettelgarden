{
  "manifest_version": 2,
  "name": "Zettelgarden",
  "version": "1.0.0",
  "description": "Create Zettelgarden cards directly from your browser",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_popup": "ui/popup.html",
    "default_title": "Zettelgarden"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/Readability.js", "content/extractor.js"],
      "run_at": "document_idle"
    }
  ]
}